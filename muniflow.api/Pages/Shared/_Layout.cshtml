<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MuniFlow</title>
    <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                background: #f5f7fa;
                color: #333;
            }
            header {
                background: linear-gradient(135deg, #1a3a6e 0%, #2b5f8a 100%);
                color: white;
                padding: 1.5rem 2rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            }
            header h1 { font-size: 1.8rem; margin: 0; }
            header p { font-size: 0.9rem; opacity: 0.9; margin-top: 0.3rem; }
            nav {
                background: white;
                padding: 1rem 2rem;
                border-bottom: 1px solid #e0e0e0;
            }
            nav a {
                color: #1a3a6e;
                text-decoration: none;
                margin-right: 1.5rem;
                font-weight: 500;
                padding: 0.5rem 1rem;
                border-radius: 4px;
                transition: background 0.2s;
            }
            nav a:hover { background: #f0f4f8; }
            main {
                max-width: 1200px;
                margin: 2rem auto;
                padding: 0 2rem;
            }
            .card {
                background: white;
                border-radius: 8px;
                padding: 2rem;
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                margin-bottom: 1.5rem;
            }
            h2 { color: #1a3a6e; margin-bottom: 1rem; }
            table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
            th {
                background: #1a3a6e;
                color: white;
                padding: 0.75rem;
                text-align: left;
            }
            td {
                padding: 0.75rem;
                border-bottom: 1px solid #e0e0e0;
            }
            tr:hover td { background: #f8fafd; }
            .status-badge {
                padding: 0.25rem 0.75rem;
                border-radius: 12px;
                font-size: 0.85rem;
                font-weight: 600;
            }
            .status-pending { background: #fff3cd; color: #856404; }
            .status-approved { background: #d4edda; color: #155724; }
            .status-rejected { background: #f8d7da; color: #721c24; }
            form { margin-top: 1rem; }
            .form-group {
                margin-bottom: 1rem;
            }
            label {
                display: block;
                margin-bottom: 0.4rem;
                font-weight: 500;
                color: #555;
            }
            input, select, textarea {
                width: 100%;
                padding: 0.6rem;
                border: 1px solid #ccc;
                border-radius: 4px;
                font-size: 0.95rem;
            }
            textarea { min-height: 80px; resize: vertical; }
            button, .btn {
                display: inline-block;
                padding: 0.6rem 1.5rem;
                background: #1a3a6e;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-size: 0.95rem;
                text-decoration: none;
                transition: background 0.2s;
            }
            button:hover, .btn:hover { background: #2b5f8a; }
            .btn-secondary { background: #6c757d; }
            .btn-secondary:hover { background: #5a6268; }
            .btn-success { background: #28a745; }
            .btn-success:hover { background: #218838; }
            .btn-danger { background: #dc3545; }
            .btn-danger:hover { background: #c82333; }
            .btn-small {
                padding: 0.3rem 0.75rem;
                font-size: 0.85rem;
                margin-right: 0.3rem;
            }
            .alert {
                padding: 1rem;
                border-radius: 4px;
                margin-bottom: 1rem;
            }
            .alert-success { background: #d4edda; color: #155724; }
            .alert-error { background: #f8d7da; color: #721c24; }
            footer {
                text-align: center;
                padding: 2rem;
                color: #888;
                font-size: 0.85rem;
            }
    </style>
</head>
<body>
    <header>
        <h1>MUNIFLOW</h1>
        <p>Municipal Purchase Order Management System</p>
    </header>
    <nav>
        <a href="/">Dashboard</a>
        <a href="/PurchaseOrders">Purchase Orders</a>
        <a href="/PurchaseOrders/Create">New Purchase Order</a>
        <a href="/swagger" target="_blank">API Docs</a>
    </nav>
    <main>
        @RenderBody()
    </main>
    <footer>
        <p>MuniFlow v1.0 &middot; Built with .NET 8, C#, MS SQL Server &middot; @DateTime.UtcNow.Year</p>
    </footer>
</body>
</html>